{
  "name": "payload",
  "version": "1.0.0",
  "description": "Payload CMS 3 on Zerops (PostgreSQL, Next.js standalone, admin + REST).",
  "private": true,
  "license": "MIT",
  "author": "Zerops",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerops-recipe-apps/payload.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build && node scripts/prepare-standalone.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "node scripts/start-standalone.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "10.1.0",
    "graphql": "16.12.0",
    "next": "16.2.11",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@babel/parser": "7.29.8",
    "next": "16.2.11"
  }
}
